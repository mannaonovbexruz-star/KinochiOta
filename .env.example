# ====================================
# .env.example — nusxa oling: cp .env.example .env
# ⚠️ Haqiqiy token/kalitlarni bu faylga YOZMANG (git'ga tushib ketadi)
# ====================================

# --- TELEGRAM ---

# @BotFather dan olingan token (MAJBURIY)
BOT_TOKEN=123456789:AA-your-real-token-here

# EGASI — sizning Telegram ID'ingiz (MAJBURIY). @userinfobot dan bilib olasiz.
# Egani hech kim o'chira olmaydi. Bir nechta egasi: ADMIN_ID=123456789,987654321
ADMIN_ID=123456789

# Parol bilan admin bo'lish (IXTIYORIY).
# Boshqa odam `/admin <parol>` yozsa admin bo'ladi va `admins` jadvaliga yoziladi.
# Bo'sh qoldirilsa — parol bilan kirish butunlay o'chiq.
# ⚠️ Parolni Telegram orqali yubormang — og'zaki ayting.
ADMIN_PASSWORD=

# --- SUPABASE ---
# Supabase Dashboard -> Project Settings -> API

# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ MAXFIY kalit (RLS'ni chetlab o'tadi, faqat serverda saqlanadi!)
# Yangi format:  sb_secret_xxxxxxxx        <- shuni oling
# Eski format:   eyJhbGci... (role: service_role)
# ❌ sb_publishable_... yoki anon kaliti ISHLAMAYDI — RLS hammasini bloklaydi
SUPABASE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Jadval nomi (sql/schema.sql dagi bilan bir xil)
MOVIES_TABLE=movies

# --- SERVER ---

# Railway/Render avtomatik beradi — dashboardda qo'lda qo'shish shart emas
PORT=8080

# /health endpointini o'chirish uchun: 0
ENABLE_HEALTH_SERVER=1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ====================================
# MAHALLIY ISHGA TUSHIRISH:
#   1. cp .env.example .env  (va qiymatlarni to'ldiring)
#   2. pip install -r requirements.txt
#   3. Supabase SQL Editor'da sql/schema.sql ni ishga tushiring
#   4. python bot.py
# ====================================
