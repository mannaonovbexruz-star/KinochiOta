# ====================================
# RAILWAY DEPLOY UCHUN ENV KO'RSATMALAR
# ====================================

# Telegram bot token (MAJBURIY! Railway dashboardga qo'shing)
# @BotFather dan olingan tokenni shu yerga yozing
# ⚠️ Bu fayl template - haqiqiy tokenni bu yerga yozmang!
BOT_TOKEN=123456789:AA-your-real-token-here

# Health check server porti (Railway avtomatik beradi, o'zgartirmang)
PORT=8080

# Ma'lumotlar papkasi (Railway persistent volume mount)
# Railwayda Volume qo'shib, /data ga mount qiling
# Mahalliy kompyuterda .env ga yozish shart emas
DATA_DIR=/data

# ====================================
# RENDER (BACKUP SERVER) UCHUN ENV KO'RSATMALAR
# ====================================
# render.yaml blueprint orqali deploy qilinadi.
# Dashboardda quyidagilarni sozlang:

# Bot token (bir xil token hamma serverda)
BOT_TOKEN=123456789:AA-your-real-token-here

# Render rejimi: webhook (backup)
MODE=webhook

# Render servisining URL manzili (o'z URL'ingiz bilan almashtiring)
SELF_URL=https://kinochi-ota-bot.onrender.com

# Asosiy (Railway) server URL - watchdog shuni kuzatadi
PRIMARY_URL=https://your-railway-app.up.railway.app

# Maxfiy kalit (webhook/aktivatsiya endpointi uchun)
SECRET_KEY=change-me-to-secret

# Ma'lumotlar papkasi
DATA_DIR=/data

# Port (Render avtomatik beradi)
PORT=10000

# ====================================
# MAHALLIY ISHLATISH UCHUN:
# 1. .env faylini .env.example dan nusxalang
# 2. BOT_TOKEN ni o'z tokeningiz bilan almashtiring
# 3. pip install -r requirements.txt
# 4. python main.py
# ====================================
