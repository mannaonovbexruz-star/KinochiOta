# ====================================
# .env.example — nusxa oling: cp .env.example .env
# ⚠️ Haqiqiy token/kalitlarni bu faylga YOZMANG (git'ga tushib ketadi)
# ====================================

# --- TELEGRAM ---

# @BotFather dan olingan token (MAJBURIY)
BOT_TOKEN=123456789:AA-your-real-token-here

# Sizning Telegram ID'ingiz (MAJBURIY). @userinfobot dan bilib olasiz.
# Bir nechta admin: ADMIN_ID=123456789,987654321
ADMIN_ID=123456789

# --- SUPABASE ---
# Supabase Dashboard -> Project Settings -> API

# Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ service_role kaliti (RLS'ni chetlab o'tadi, faqat serverda saqlanadi!)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Jadval nomi (sql/schema.sql dagi bilan bir xil)
MOVIES_TABLE=movies

# --- SERVER ---

# Railway/Render avtomatik beradi — dashboardda qo'lda qo'shish shart emas
PORT=8080

# /health endpointini o'chirish uchun: 0
ENABLE_HEALTH_SERVER=1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ====================================
# MAHALLIY ISHGA TUSHIRISH:
#   1. cp .env.example .env  (va qiymatlarni to'ldiring)
#   2. pip install -r requirements.txt
#   3. Supabase SQL Editor'da sql/schema.sql ni ishga tushiring
#   4. python bot.py
# ====================================
